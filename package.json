{
  "name": "shillbid-watchdog",
  "version": "1.0.0",
  "description": "AI-powered shill bid detection using Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create shillbid-watchdog-db",
    "db:migrate": "wrangler d1 execute shillbid-watchdog-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute shillbid-watchdog-db --local --file=./schema.sql",
    "kv:create": "wrangler kv namespace create CACHE",
    "vectorize:create": "wrangler vectorize create bid-patterns --dimensions=768 --metric=cosine"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^0.0.15",
    "hono": "^4.0.0",
    "playwright": "^1.58.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.3.0",
    "wrangler": "^3.99.0"
  }
}
